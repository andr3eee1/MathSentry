# MathSentry Olympiad Server Configuration
PORT=4000
# REQUIRED (32+ characters) unless NODE_ENV=development. Generate one with: openssl rand -hex 32
JWT_SECRET=
# development: local use only. Enables the insecure built-in JWT secret, the offline demo grader
#              and the seeded demo account.
# !! PRODUCTION MUST SET NODE_ENV=production AND a 32+ character JWT_SECRET. The server refuses
# !! to start without that secret; anything other than "development" disables the dev-only features.
NODE_ENV=development

# Number of reverse proxies in front of the server (used for the real client IP in rate limiting).
# Leave empty when exposed directly. Set TRUST_PROXY=1 when behind exactly one proxy/tunnel
# (cloudflared, ngrok, nginx). A wrong value lets clients spoof X-Forwarded-For.
TRUST_PROXY=

# Google Gemini (Vision OCR + grading)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Custom Olympiad LoRA Model (Google Colab GPU / Local API)
# Paste the Cloudflare Tunnel URL printed by dataset/colab_mathsentry_api.ipynb
# Example: LORA_API_URL=https://random-subdomain.trycloudflare.com
LORA_API_URL=

# AI audits per user per UTC day (protects your API bill; basis for a paid tier)
DAILY_ANALYSIS_LIMIT=20
GUEST_DAILY_ANALYSIS_LIMIT=5

# Hard stop for all users combined per UTC day (cost safety net)
GLOBAL_DAILY_AUDIT_LIMIT=2000

# --- Billing (Pro plan) ---
# Stripe secret key (sk_test_... or sk_live_...). When set, /billing/checkout creates real Stripe
# Checkout Sessions. Production should also add a webhook for checkout.session.completed;
# confirm-on-return (POST /billing/confirm) is enough for the demo.
STRIPE_SECRET_KEY=
# Public base URL of this server for Stripe redirects (e.g. an ngrok URL; no trailing slash, no /api).
# If empty it is derived from the request.
PUBLIC_API_BASE=
# true = fake checkout with the 4242 test card, no real money (implied by NODE_ENV=development).
BILLING_DEMO=false
# Pro price in bani (1999 = 19,99 lei) and subscription length per payment.
PRO_PRICE_BANI=1999
PRO_PERIOD_DAYS=30
# AI audits per Pro user per UTC day
PRO_DAILY_ANALYSIS_LIMIT=200
