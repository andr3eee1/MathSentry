{
  "expo": {
    "name": "MathSentry",
    "slug": "mathsentry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mathsentry",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "MathSentry folosește camera telefonului pentru a fotografia direct problemele și rezolvările scrise de mână pe foaie.",
        "NSPhotoLibraryUsageDescription": "MathSentry accesează galeria pentru selectarea foilor de concurs fotografiate."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite accesul la cameră pentru a fotografia direct problema sau demonstrația scrisă de mână pe foaie."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite accesul la fotografii pentru analiza foilor de concurs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
